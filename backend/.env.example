# Copy to .env and fill in from the lab environment handout, then set LAB_ALIAS.
# LAB_ALIAS: 2-12 characters, lowercase letters and digits. Use your lab username.

LAB_ALIAS=changeme

PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
AOAI_ENDPOINT=https://<foundry-resource>.openai.azure.com
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
STORAGE_ACCOUNT=<storage-account>

SEARCH_API_VERSION=2026-08-01-preview
CU_API_VERSION=2025-11-01
CLAIMS_CONTAINER=claims
POLICY_CONTAINER=policies
KB_NAME=contoso-claims-kb
KB_CONNECTION_NAME=contoso-claims-kb-mcp
CHAT_DEPLOYMENT=gpt-5.5
MINI_DEPLOYMENT=gpt-5.4-mini
